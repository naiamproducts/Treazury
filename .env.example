# Treazury — environment template. Copy to `.env` and fill in.
# Names derived from source only; placeholders, never real values.
# Edge-function secrets (Deno.env.get in supabase/functions/) are not read
# from this file.

# Required — Supabase (src/lib/supabase.ts throws without these)
VITE_SUPABASE_URL=your-supabase-url-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Optional — Privy embedded wallets for the merchant (src/wallet/config.ts)
VITE_PRIVY_APP_ID=your-privy-app-id-here

# Optional — invitation-only alpha: 'true' shows the register CTA;
# leave unset/empty to hide it (src/components/AuthPage.tsx)
VITE_SHOW_REGISTER=

# Optional — WalletConnect project id (src/config.ts falls back to a dev
# placeholder when unset)
VITE_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id-here

# Router owner's private key — testnet/PoC only — never a funded key.
# VITE_* is inlined into the public JS bundle; production signing belongs in
# an edge function (usdc-arc.ts). Empty/absent (<= 2 chars) = no vault deploy.
VITE_ROUTER_OWNER_KEY=your-testnet-only-private-key-here

# Retired — old browser-direct flow; do not set (see
# supabase/functions/circle-wallet/index.ts):
# VITE_CIRCLE_API_KEY=
